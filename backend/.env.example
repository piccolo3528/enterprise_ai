# =============================================================================
# Enterprise Knowledge Intelligence Platform: backend configuration template
#
# 1. Copy this file to backend/.env   (PowerShell: Copy-Item .env.example .env)
# 2. Fill in the values. backend/.env is git-ignored. NEVER commit it.
# 3. Everything below is a placeholder, not a real credential.
# =============================================================================

# --- General --------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- PostgreSQL (Neon) -------------------------------------------------------
# From the Neon console: Project -> Connect. Two strings are needed:
#
# DATABASE_URL: the POOLED connection (host contains "-pooler"). Used by the app.
#   Neon's pooler is PgBouncer in transaction mode; it lets many short-lived app
#   connections share a few real Postgres connections.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# DATABASE_MIGRATION_URL: the DIRECT connection (same host WITHOUT "-pooler").
#   Used only by Alembic. Neon recommends direct connections for schema migrations.
DATABASE_MIGRATION_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# TEST_DATABASE_URL: pooled connection to a separate Neon BRANCH named "test".
#   Integration tests run here so they can never touch your development data.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Notes:
#  - "postgresql+psycopg://" tells SQLAlchemy to use the psycopg 3 driver.
#    Neon's console shows "postgresql://..."; add "+psycopg" after "postgresql".
#  - If your password contains special characters (@ : / ? # &), URL-encode them.

# --- Qdrant (vector database) --------------------------------------------------
# Local Windows binary (default): http://127.0.0.1:6333 and leave QDRANT_API_KEY empty.
# Qdrant Cloud free tier (fallback): https://<cluster>.<region>.<provider>.cloud.qdrant.io:6333
#   plus the cluster's Database API key.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# --- Google Gemini --------------------------------------------------------------
# Create a key at https://aistudio.google.com (API keys). Keep it here only.
# Free-tier limits are per Google Cloud project; check yours on the AI Studio
# rate-limit page and set GEMINI_RPM_LIMIT to your project's requests-per-minute.
# Free-tier content may be used by Google to improve its products: do not upload
# confidential documents while using the free tier.
GEMINI_API_KEY=
GEMINI_MODEL_ANSWER=gemini-3.5-flash-lite
GEMINI_MODEL_UTILITY=gemini-3.5-flash-lite
GEMINI_RPM_LIMIT=10

# --- Groq (optional, free tier) -- NOT wired into the app yet --------------------
# Groq (with a "q") is a different company from xAI's Grok. Planned as an OPTIONAL
# fallback LLM provider (PROJECT_TRACKER decision D22); Gemini stays the default.
# Key:    https://console.groq.com/keys
# Limits: https://console.groq.com/settings/limits (per organization)
# Model:  chosen from https://console.groq.com/docs/models when the integration starts.
GROQ_API_KEY=
GROQ_MODEL=

# --- Local models (downloaded from Hugging Face on first use, run on CPU) --------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Authentication ---------------------------------------------------------------
# Generate a long random secret, e.g. in PowerShell (with the venv active):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# --- Uploads ------------------------------------------------------------------------
# Relative paths are resolved from the backend/ folder. Git-ignored.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# --- RAG tuning (defaults; revisited with evaluation data in M10) --------------------
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
CONTEXT_TOKEN_BUDGET=5000
