# =============================================================================
# Enterprise Knowledge Intelligence Platform: backend configuration template
#
# 1. Copy this file to backend/.env   (PowerShell: Copy-Item .env.example .env)
# 2. Fill in the values. backend/.env is git-ignored. NEVER commit it.
# 3. Everything below is a placeholder, not a real credential.
# =============================================================================

# --- General --------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- PostgreSQL (Neon) -------------------------------------------------------
# From the Neon console: Project -> Connect. Two strings are needed:
#
# DATABASE_URL: the POOLED connection (host contains "-pooler"). Used by the app.
#   Neon's pooler is PgBouncer in transaction mode; it lets many short-lived app
#   connections share a few real Postgres connections.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# DATABASE_MIGRATION_URL: the DIRECT connection (same host WITHOUT "-pooler").
#   Used only by Alembic. Neon recommends direct connections for schema migrations.
DATABASE_MIGRATION_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# TEST_DATABASE_URL: pooled connection to a separate Neon BRANCH named "test".
#   Integration tests run here so they can never touch your development data.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Notes:
#  - "postgresql+psycopg://" tells SQLAlchemy to use the psycopg 3 driver.
#    Neon's console shows "postgresql://..."; add "+psycopg" after "postgresql" in ALL three.
#  - Create the Neon project in the region closest to where the backend runs (it can't be
#    changed later). This project uses AWS Asia Pacific 1 (Singapore).
#  - If your password contains special characters (@ : / ? # &), URL-encode them.

# --- Qdrant (vector database) --------------------------------------------------
# Qdrant Cloud free tier (used by this project): https://<cluster>.<region>.<provider>.cloud.qdrant.io:6333
#   plus the cluster's Database API key. Pick the free region closest to where the backend runs.
# Local Windows binary (alternative): http://127.0.0.1:6333 and leave QDRANT_API_KEY empty.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# --- Google Gemini --------------------------------------------------------------
# Create a key at https://aistudio.google.com (API keys). Keep it here only.
# Free-tier limits are per Google Cloud project; check yours on the AI Studio
# rate-limit page and set GEMINI_RPM_LIMIT to your project's requests-per-minute.
# Free-tier content may be used by Google to improve its products: do not upload
# confidential documents while using the free tier.
GEMINI_API_KEY=
GEMINI_MODEL_ANSWER=gemini-3.5-flash-lite
GEMINI_MODEL_UTILITY=gemini-3.5-flash-lite
# Fallback chain (M15): this model is tried next, on the same key, with its own free daily
# quota; empty = skip it. Then Groq, if GROQ_API_KEY is set.
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
# The evaluation's answer judge (evaluation/run_answers.py): groq (a different model family from
# the Gemini answerers) or gemini (GEMINI_MODEL_JUDGE)
JUDGE_PROVIDER=groq
GEMINI_MODEL_JUDGE=gemini-3.1-flash-lite
GEMINI_RPM_LIMIT=10
# Generation settings (M12). Defaults shown; uncomment to change.
# LLM_TEMPERATURE=0.1
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TIMEOUT_SECONDS=25     # per attempt
# LLM_MAX_RETRIES=2          # on per-minute 429s, 5xx and timeouts (never on daily quota)

# --- Groq (optional, free tier) -- NOT wired into the app yet --------------------
# Groq (with a "q") is a different company from xAI's Grok. Planned as an OPTIONAL
# fallback LLM provider (PROJECT_TRACKER decision D22); Gemini stays the default.
# Key:    https://console.groq.com/keys
# Limits: https://console.groq.com/settings/limits (per organization)
# The last step of the fallback chain (M15). Free tier measured 2026-11-23: 1,000 requests/day,
# 8,000 tokens/minute per model. Behind a TLS-inspecting gateway, calls use the Windows store.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM_LIMIT=30

# --- Local models (downloaded from Hugging Face on first use, run on CPU) --------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Authentication ---------------------------------------------------------------
# Generate a long random secret, e.g. in PowerShell (with the venv active):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# How long a login lasts. After this the user signs in again.
JWT_EXPIRE_MINUTES=60
# The session cookie is marked Secure (HTTPS only). Browsers accept that on http://localhost,
# so leave this true unless you serve the app over plain HTTP from another host name.
COOKIE_SECURE=true

# --- Per-user limits (M16; kept in memory, reset when the server restarts) ----------
# 150 questions a day = ~300 Gemini calls (plan + answer), inside flash-lite's ~500 free.
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_DAY=150
RATE_LIMIT_UPLOADS_PER_HOUR=20
# Failed sign-ins in 15 minutes, per email and per client address.
RATE_LIMIT_LOGIN_FAILURES_PER_EMAIL=5
RATE_LIMIT_LOGIN_FAILURES_PER_ADDRESS=20
RATE_LIMIT_REGISTRATIONS_PER_HOUR=5
# /docs and /openapi.json: handy in development; set false on a public host.
API_DOCS_ENABLED=true

# --- Uploads ------------------------------------------------------------------------
# Relative paths are resolved from the backend/ folder. Git-ignored.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# --- RAG tuning (defaults; revisited with evaluation data in M10) --------------------
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
# auto | fixed | overlap | recursive | heading (auto = heading-aware when a document has headings)
CHUNK_STRATEGY=auto
RETRIEVAL_TOP_K=20
CONTEXT_TOKEN_BUDGET=5000
# Passages given to the LLM per question (M12; the token budget above still caps them)
CONTEXT_MAX_SOURCES=10
# Conversation memory (M13): turns given to the follow-up rewriter, trimmed to this many tokens
HISTORY_MAX_TURNS=6
HISTORY_TOKEN_BUDGET=1500
# Retrieval techniques (M14), each measured in evaluation/reports/2026-11-20_retrieval_*.md
# Cross-encoder reranking: off (it ranked worse than hybrid search on our data and took 4-8 s)
RERANK_ENABLED=false
RERANK_POOL=20
# Outdated versions (front matter status): off | demote (below current ones) | filter (removed)
VERSION_MODE=demote
# Fetch a document's amendments with it: off (no measured gain: amendments already rank first)
AMENDMENTS_ENABLED=false
# Extra phrasings from one Gemini call before searching (first questions: 1 extra call)
MULTI_QUERY_ENABLED=true
